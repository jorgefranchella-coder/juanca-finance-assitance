[Unit]
Description=Juanca application F3 shadow (financial read-only, guided chat)
Requires=juanca-shadow-postgres.service
After=juanca-shadow-postgres.service

[Service]
WorkingDirectory=/home/jorge/juanca
ExecStart=/home/jorge/.local/bin/node --experimental-strip-types services/application/src/server.ts
Environment=JUANCA_DATABASE=juanca_shadow
Environment=JUANCA_SHADOW_CONFIG=/home/jorge/.local/share/juanca-shadow/application.json
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
