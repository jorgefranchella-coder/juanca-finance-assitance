[Unit]
Description=Juanca B3 ingestion parser worker (shadow)
Requires=juanca-shadow-postgres.service
After=juanca-shadow-postgres.service

[Service]
WorkingDirectory=/home/jorge/juanca
ExecStart=/home/jorge/.local/bin/node --experimental-strip-types services/ingestion/src/worker.ts
Environment=JUANCA_DATABASE=juanca_shadow
Environment=JUANCA_INGESTION_CONFIG=/home/jorge/.local/share/juanca-shadow/ingestion.json
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
