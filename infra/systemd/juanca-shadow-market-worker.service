[Unit]
Description=Juanca market refresh worker F4 shadow
Requires=juanca-shadow-postgres.service
After=juanca-shadow-postgres.service

[Service]
WorkingDirectory=/home/jorge/juanca
ExecStart=/home/jorge/.local/bin/node --experimental-strip-types services/market/src/worker.ts
Environment=JUANCA_DATABASE=juanca_shadow
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
