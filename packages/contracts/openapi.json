{
  "openapi": "3.1.0",
  "info": {
    "title": "Juanca application shadow API",
    "version": "0.17.0",
    "description": "F3/F4 shadow API: immutable portfolio, guided conversation, durable manual evidence with versioned local text and photo OCR/trade interpretations, and read-only review queues; financial application remains separate."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3050"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/v1/reconciliation/b3/candidates": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Private B3 reconciliation candidates; no financial changes are applied",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["reports", "count", "limit", "mode", "authoritative", "apply_enabled"],
                  "properties": {
                    "reports": {"type": "array", "items": {"type": "object"}},
                    "count": {"type": "integer"},
                    "limit": {"type": "integer"},
                    "mode": {"const": "shadow"},
                    "authoritative": {"const": false},
                    "apply_enabled": {"const": false}
                  }
                }
              }
            }
          },
          "401": {"description": "Authentication required"},
          "422": {"description": "Invalid limit"},
          "503": {"description": "Private report storage unavailable"}
        }
      }
    },
    "/v1/reconciliation/b3/decisions": {
      "post": {
        "security": [{"bearerAuth": []}],
        "summary": "Record an audited review of one B3 snapshot difference",
        "description": "Evidence review only; no positions, cash, events or portfolio revision change.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {
          "type": "object", "additionalProperties": false,
          "required": ["request_key", "prior_document_id", "current_document_id", "candidate_key", "decision"],
          "properties": {
            "request_key": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]{8,128}$"},
            "prior_document_id": {"type": "string", "format": "uuid"},
            "current_document_id": {"type": "string", "format": "uuid"},
            "candidate_key": {"type": "string", "minLength": 1, "maxLength": 1000},
            "decision": {"enum": ["confirmed", "dismissed"]}
          }
        }}}},
        "responses": {
          "201": {"description": "Audited evidence-only decision; portfolio_changed is false", "content": {"application/json": {"schema": {
            "type": "object", "additionalProperties": false,
            "required": ["decision_id", "decision", "revision", "replayed", "mode", "portfolio_changed"],
            "properties": {
              "decision_id": {"type": "string", "format": "uuid"},
              "decision": {"enum": ["confirmed", "dismissed"]},
              "revision": {"type": "integer", "minimum": 1},
              "replayed": {"type": "boolean"},
              "mode": {"const": "shadow"},
              "portfolio_changed": {"const": false}
            }
          }}}},
          "401": {"description": "Authentication required"},
          "403": {"description": "Actor lacks reviewer membership"},
          "405": {"description": "Method not allowed"},
          "409": {"description": "Idempotency mismatch or candidate no longer present"},
          "413": {"description": "Request body exceeds the size limit"},
          "422": {"description": "Invalid decision input"},
          "415": {"description": "Content-Type must be application/json"},
          "503": {"description": "Application database unavailable"}
        }
      }
    },
    "/v1/reconciliation/manual-b3/candidates": {
      "get": {
        "security": [{"bearerAuth": []}],
        "summary": "Suggest exact written-evidence to B3 movement matches for human review",
        "responses": {
          "200": {"description": "Derived candidates; household, instrument, exact quantity and date-window match; no link or portfolio change is applied"},
          "401": {"description": "Authentication required"}
        }
      }
    },
    "/v1/reconciliation/manual-b3/decisions": {
      "post": {
        "security": [{"bearerAuth": []}],
        "summary": "Record an audited human decision about one written-to-B3 evidence link",
        "requestBody": {"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["request_key","intake_id","assertion_id","decision"],"properties":{"request_key":{"type":"string","minLength":8,"maxLength":128},"intake_id":{"type":"string","format":"uuid"},"assertion_id":{"type":"string","minLength":8,"maxLength":128},"decision":{"enum":["related","not_related"]}}}}}},
        "responses": {
          "201": {"description":"Audited evidence-only decision; no positions, cash, events or portfolio revision are changed"},
          "403": {"description":"Actor lacks reviewer membership"},
          "409": {"description":"Idempotency mismatch or candidate is stale"},
          "422": {"description":"Invalid decision input"}
        }
      }
    },
    "/v1/portfolio": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "portfolio_version",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Immutable shadow view; not financial authority",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./portfolio-v1.schema.json#/$defs/Portfolio"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./portfolio-v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown scoped resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./portfolio-v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid query or cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./portfolio-v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./portfolio-v1.schema.json#/$defs/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/position-identities": {
      "get": {
        "security": [{ "bearerAuth": [] }],
        "summary": "List persisted position identities and their latest account resolution",
        "responses": {
          "200": {
            "description": "Shadow identity evidence; does not change published holdings",
            "content": { "application/json": { "schema": { "type": "object", "required": ["positions", "mode", "authoritative", "portfolio_changed"], "properties": { "positions": { "type": "array", "items": { "type": "object" } }, "mode": { "const": "shadow" }, "authoritative": { "const": false }, "portfolio_changed": { "const": false } } } } }
          }
        }
      }
    },
    "/v1/position-identities/{position_id}/acquisitions": {
      "parameters": [{ "name": "position_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "get": {
        "security": [{ "bearerAuth": [] }],
        "summary": "List append-only acquisition evidence and corrections for one position",
        "responses": { "200": { "description": "Shadow acquisition history; not included in portfolio calculations", "content": { "application/json": { "schema": { "type": "object" } } } }, "404": { "description": "Position not found" } }
      },
      "post": {
        "security": [{ "bearerAuth": [] }],
        "summary": "Record or correct an acquisition lot as shadow evidence",
        "parameters": [{ "name": "X-Juanca-Actor", "in": "header", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["request_key", "effective_date", "quantity", "unit_price", "currency", "evidence_kind", "evidence_id"], "properties": { "request_key": { "type": "string", "minLength": 8, "maxLength": 128 }, "acquisition_id": { "type": "string", "format": "uuid" }, "supersedes_revision": { "type": "integer", "minimum": 1 }, "effective_date": { "type": "string", "format": "date" }, "quantity": { "type": "string", "pattern": "^\\d{1,18}(?:\\.\\d{1,10})?$" }, "unit_price": { "type": "string", "pattern": "^\\d{1,18}(?:\\.\\d{1,10})?$" }, "fees_minor": { "type": "integer", "minimum": 0 }, "currency": { "enum": ["BRL", "USD"] }, "evidence_kind": { "enum": ["source_assertion", "event", "manual", "legacy_review"] }, "evidence_id": { "type": "string", "minLength": 1, "maxLength": 500 }, "voided": { "type": "boolean" } } } } } },
        "responses": { "201": { "description": "Recorded revision; published portfolio unchanged", "content": { "application/json": { "schema": { "type": "object", "required": ["acquisition_id", "revision", "replayed", "mode", "portfolio_changed"], "properties": { "acquisition_id": { "type": "string" }, "revision": { "type": "integer" }, "replayed": { "type": "boolean" }, "mode": { "const": "shadow" }, "portfolio_changed": { "const": false } } } } } }, "409": { "description": "Idempotency or revision conflict" }, "422": { "description": "Invalid acquisition evidence" } }
      }
    },
    "/v1/positions": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "portfolio_version",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          {
            "name": "owner_id",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Immutable shadow view; not financial authority",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./portfolio-v1.schema.json#/$defs/PositionPage"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./portfolio-v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown scoped resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./portfolio-v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid query or cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./portfolio-v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./portfolio-v1.schema.json#/$defs/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/owners": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Owners scoped to the authenticated household",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "owners"
                  ],
                  "properties": {
                    "owners": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "display_name"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "display_name": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/v1/conversations/family/messages": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Household conversation and selected read-only archive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./portfolio-v1.schema.json#/$defs/ChatResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./portfolio-v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./portfolio-v1.schema.json#/$defs/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./portfolio-v1.schema.json#/$defs/ChatInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Guided reply; stores conversation only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./portfolio-v1.schema.json#/$defs/ChatResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./portfolio-v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./portfolio-v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency or busy conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./portfolio-v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./portfolio-v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./portfolio-v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./portfolio-v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./portfolio-v1.schema.json#/$defs/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/evidence/text": {
      "get": {
        "security": [{"bearerAuth": []}],
        "summary": "List recent written evidence and local interpretations for review",
        "parameters": [{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":100,"default":50}}],
        "responses": {"200":{"description":"Recent evidence; read-only and does not change portfolio facts"},"422":{"description":"Invalid limit"}}
      },
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Register original written movement as evidence pending review",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "request_id",
                  "owner",
                  "text"
                ],
                "properties": {
                  "request_id": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 128
                  },
                  "owner": {
                    "enum": [
                      "Jorge",
                      "Julia"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  },
                  "occurred_on": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Original text retained with deterministic local interpretation for human review; portfolio unchanged"
          },
          "409": {
            "description": "Idempotency key reused for a different text"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/v1/evidence/text/{id}": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Read the registered text and review status",
        "responses": {
          "200": {
            "description": "Stored original evidence and any versioned local interpretation"
          },
          "404": {
            "description": "Not found in this household"
          }
        }
      }
    },
    "/v1/evidence/photos": {
      "get": {
        "security": [{"bearerAuth": []}],
        "summary": "List recent manually uploaded photos and saved OCR/trade interpretations",
        "parameters": [{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":100,"default":50}}],
        "responses": {"200":{"description":"Household-scoped photo metadata, versioned OCR and append-only deterministic manual-trade parser interpretations when OCR is available. Interpretations require human review and never apply portfolio facts."},"422":{"description":"Invalid limit"},"503":{"description":"Ingestion service unavailable"}}
      },
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Start a manual photo upload through the application boundary",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "request_id",
                  "owner",
                  "file_name",
                  "content_sha256",
                  "byte_size",
                  "content_type"
                ],
                "properties": {
                  "request_id": {
                    "type": "string"
                  },
                  "owner": {
                    "enum": [
                      "Jorge",
                      "Julia"
                    ]
                  },
                  "occurred_on": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date"
                  },
                  "file_name": {
                    "type": "string"
                  },
                  "content_sha256": {
                    "type": "string"
                  },
                  "byte_size": {
                    "type": "integer",
                    "maximum": 20000000
                  },
                  "content_type": {
                    "enum": [
                      "image/jpeg",
                      "image/png",
                      "image/webp",
                      "image/heic"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Durable upload intent; send bytes to returned content_url"
          },
          "409": {
            "description": "Idempotency mismatch"
          },
          "422": {
            "description": "Invalid metadata"
          }
        }
      }
    },
    "/v1/evidence/photos/{id}/content": {
      "get": {
        "security": [{"bearerAuth": []}],
        "summary": "Read a stored manual photo after household and content-hash verification",
        "responses": {"200":{"description":"Verified image bytes from private ingestion storage"},"404":{"description":"Photo not found in this household"},"409":{"description":"Photo is not stored yet"},"502":{"description":"Image hash verification failed"}}
      },
      "put": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Store photo bytes after SHA-256 and size verification",
        "responses": {
          "201": {
            "description": "Document and assignment stored"
          },
          "422": {
            "description": "Bytes differ from declared metadata"
          }
        }
      }
    },
    "/v1/evidence/photos/{id}": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Read the upload, document and parser status",
        "responses": {
          "200": {
            "description": "Scoped upload status"
          },
          "404": {
            "description": "Not found in this household"
          }
        }
      }
    },
    "/v1/evidence/documents": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Start a B3, Avenue or pension document upload as immutable evidence",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "request_id",
                  "owner",
                  "source",
                  "file_type",
                  "file_name",
                  "content_sha256",
                  "byte_size",
                  "content_type"
                ],
                "properties": {
                  "request_id": {
                    "type": "string"
                  },
                  "owner": {
                    "enum": [
                      "Jorge",
                      "Julia"
                    ]
                  },
                  "source": {
                    "enum": [
                      "b3",
                      "avenue",
                      "pension"
                    ]
                  },
                  "file_type": {
                    "enum": [
                      "positions",
                      "movements",
                      "avenue_statement",
                      "avenue_confirmation",
                      "pension_statement"
                    ]
                  },
                  "reference_date": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date"
                  },
                  "file_name": {
                    "type": "string"
                  },
                  "content_sha256": {
                    "type": "string"
                  },
                  "byte_size": {
                    "type": "integer",
                    "maximum": 30000000
                  },
                  "content_type": {
                    "enum": [
                      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                      "application/pdf"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Upload intent stored"
          },
          "409": {
            "description": "Idempotency mismatch"
          },
          "422": {
            "description": "Invalid metadata"
          }
        }
      }
    },
    "/v1/evidence/documents/{id}/content": {
      "put": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Store document bytes with declared length and SHA-256 verification",
        "responses": {
          "201": {
            "description": "Document and assignment stored"
          },
          "422": {
            "description": "Bytes or type differ from intent"
          }
        }
      }
    },
    "/v1/evidence/documents/{id}": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Read the document and parser job status within the configured household",
        "responses": {
          "200": {
            "description": "Scoped status"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    }
  }
}
